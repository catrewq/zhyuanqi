{
  // "compilerOptions": {
  //   "target": "es2016",                                  
  //   "module": "commonjs",                                
  //   "esModuleInterop": true,                                                 
  //   "forceConsistentCasingInFileNames": true,           
  //   "strict": true,                                      
  //   "skipLibCheck": true,                           
  // }
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react",
    "allowJs": true,
    "target": "es2016",
    "module": "commonjs",
    "strict": true,
    "paths": {
      
    },
    "baseUrl": "./",
    "outDir": "./build",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "importHelpers": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.svg"
  ],
  "exclude": [
    "node_modues"
  ]
}